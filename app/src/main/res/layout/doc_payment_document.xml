<?xml version="1.0" encoding="utf-8"?>
<!--
  مستند يُرسل للأهالي (إيصال دفع أو كشف حساب)؛ يُرسم خارج الشاشة بالوضع الفاتح ويُشارك صورة أو PDF.
  رأس + بطاقة المبلغ الأهم + قسم تفاصيل + ملاحظة + تذييل.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/docRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    tools:ignore="Overdraw"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvDocType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="إيصال دفع" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDocMeta"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.TalibPay.Caption"
        tools:text="رقم الإيصال R-4F2A9C · 03/11/2026" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp" />

    <TextView
        android:id="@+id/tvStudentName"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        tools:text="Lana Salama" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:textAlignment="viewStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="رسوم نوفمبر 2026" />

    <!-- المبلغ الأهم في المستند -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/tvHighlightLabel"
                style="@style/Widget.TalibPay.StatLabel"
                tools:text="المبلغ المدفوع" />

            <TextView
                android:id="@+id/tvHighlightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnPrimaryContainer"
                tools:text="150 ₪" />

            <LinearLayout
                android:id="@+id/highlightRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:textAppearance="@style/TextAppearance.TalibPay.SectionTitle"
        tools:text="التفاصيل" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.TalibPay.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/sectionRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_note"
        android:padding="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.TalibPay.Caption"
        tools:text="TalibPay · أُنشئ في 03/11/2026" />
</LinearLayout>
