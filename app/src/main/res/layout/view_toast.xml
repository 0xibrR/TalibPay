<?xml version="1.0" encoding="utf-8"?>
<!-- Custom toast: card بلون inverse surface مع icon حسب النوع (انظر util/AppToast.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_toast"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/toastIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_toast_success"
        tools:tint="@color/toast_success" />

    <TextView
        android:id="@+id/toastText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:textAlignment="viewStart"
        android:textColor="@color/md_inverse_on_surface"
        android:textSize="14sp"
        tools:text="تمت إضافة الطالب بنجاح" />
</LinearLayout>
