<?xml version="1.0" encoding="utf-8"?>
<!-- محتوى نافذة الاسترداد من المحفظة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/refundAmountLayout"
        style="@style/Widget.TalibPay.TextField"
        android:hint="@string/refund_amount"
        app:startIconDrawable="@drawable/ic_cash"
        app:suffixText="@string/currency_symbol">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtRefundAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.TalibPay.TextField"
        android:hint="@string/additional_notes_optional"
        app:startIconDrawable="@drawable/ic_notes">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtRefundNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="200" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
