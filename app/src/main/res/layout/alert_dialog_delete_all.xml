<?xml version="1.0" encoding="utf-8"?>
<!-- تأكيد حذف كل الطلاب: يتطلب سحبًا متعمدًا لمنع الحذف بالخطأ -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.TalibPay.DialogCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_delete_sweep"
            app:tint="?attr/colorError" />

        <TextView
            android:id="@+id/alertTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/are_you_sure_you_want_to_delete_all_student"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/this_process_is_irreversible"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError" />

        <com.ncorti.slidetoact.SlideToActView
            android:id="@+id/slideConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:area_margin="6dp"
            app:border_radius="28dp"
            app:inner_color="?attr/colorOnError"
            app:outer_color="?attr/colorError"
            app:slider_height="56dp"
            app:text="@string/slide_to_delete_all"
            app:text_appearance="@style/TextAppearance.Material3.LabelLarge"
            app:text_color="?attr/colorOnError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/img_btn_cancel_dialog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cancel" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
