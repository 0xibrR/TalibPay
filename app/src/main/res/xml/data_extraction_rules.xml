<?xml version="1.0" encoding="utf-8"?><!--
   بيانات الطلاب المالية (كاش Firebase والإعدادات) لا تُنسخ احتياطيًا ولا تُنقل لجهاز آخر؛
   المصدر الوحيد للبيانات هو Firebase بعد تسجيل الدخول.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
