{
  "rules": {
    "TalibPay": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com')",
        ".write": "auth != null && auth.uid === $uid && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com')",
        "students": {
          "$studentId": {
            ".validate": "newData.hasChildren(['id', 'name']) && newData.child('id').val() === $studentId",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "birthYear": { ".validate": "newData.isString() && newData.val().length <= 4" },
            "registrationDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "monthlyFee": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "billingStart": { ".validate": "newData.isString() && newData.val().length <= 10" },
            "lastBilledPeriod": { ".validate": "newData.isString() && newData.val().length <= 7" },
            "phoneNumber": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "paidCash": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "paidBank": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "paid": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "charges": {
              "$chargeId": {
                ".validate": "newData.hasChildren(['id', 'amount']) && newData.child('id').val() === $chargeId",
                "title": { ".validate": "newData.isString() && newData.val().length <= 100" },
                "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "dueDate": { ".validate": "newData.isString() && newData.val().length <= 10" },
                "period": { ".validate": "newData.isString() && newData.val().length <= 7" },
                "note": { ".validate": "newData.isString() && newData.val().length <= 500" }
              }
            },
            "payments": {
              "$paymentId": {
                ".validate": "newData.hasChildren(['id', 'cash', 'bank', 'total']) && newData.child('id').val() === $paymentId",
                "chargeId": { ".validate": "newData.isString() && newData.val().length <= 64" },
                "cash": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "bank": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "note": { ".validate": "newData.isString() && newData.val().length <= 2000" }
              }
            }
          }
        }
      }
    }
  }
}
